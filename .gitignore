# Ignore all data files (large/raw artifacts)
data/**

# Keep the folder structure and README files tracked
!data/
!data/**/
!data/**/README.md

# Keep processed folder structure tracked, but exclude processed CSV payloads
!data/processed/
!data/processed/**/
!data/processed/**/README.md
data/processed/**/*.csv
data/processed/**/*.csv.gz

# Python cache files
__pycache__/
*.pyc
.ipynb_checkpoints/

# Ignore packaged complete-folder datasets (large files)
Complete Folder/datasets/

# Ignore local packaged zip snapshot
Complete_Folder_*.zip
