    "map_mean_1h",
    "map_mean_3h",
    "map_mean_5h",
    "map_slope_5h",
    "resp_rate",
    "resp_rate_mean_1h",
    "resp_rate_mean_3h",
    "resp_rate_mean_5h",
    "resp_rate_slope_5h",
    "sbp",
    "sbp_mean_1h",
    "sbp_mean_3h",
    "sbp_mean_5h",
    "sbp_slope_5h",
    "spo2",
    "spo2_mean_1h",
    "spo2_mean_3h",
    "spo2_mean_5h",
    "spo2_slope_5h",
    "temp_f",
    "temp_f_mean_1h",
